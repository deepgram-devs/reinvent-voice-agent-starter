# Required: server-side Deepgram key. Never commit your .env.
# https://console.deepgram.com/
DEEPGRAM_API_KEY=

# deepgram (Python server) or pipecat (Python server + local pipeline).
VOICE_BACKEND=deepgram

# Think-Fast requires Early Access. For the deepgram backend only, a managed
# fallback is THINK_PROVIDER=open_ai with THINK_MODEL=gpt-4o-mini.
# Pipecat currently requires the defaults and direct Think-Fast endpoint access.
# THINK_PROVIDER=deepgram
# THINK_MODEL=think-fast
# VOICE=flux-alexis-en

# Required for access from other devices or deployment. Without it, loopback only.
# BOOTH_PASSCODE=
# PORT=3000
# Change to your fork to update the on-screen QR code.
# REPO_URL=https://github.com/deepgram-devs/reinvent-voice-agent-starter

# Pipecat only: choose a random shared secret. Both processes load this file.
# PIPECAT_TOKEN=
# PIPECAT_URL=ws://127.0.0.1:7861/agent
# PIPECAT_PORT=7861
