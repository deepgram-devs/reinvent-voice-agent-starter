# Your Deepgram API key: https://console.deepgram.com (free credit when you sign up)
DEEPGRAM_API_KEY=

# Optional. Without Early Access to Think-Fast, use a Deepgram-managed LLM instead:
# THINK_PROVIDER=open_ai
# THINK_MODEL=gpt-4o-mini
# VOICE=flux-alexis-en
# The QR code on the booth screen opens this. Point it at your fork.
# REPO_URL=https://github.com/deepgram-devs/reinvent-voice-agent-starter
# Without it, only this computer can open the booth. Set it to use the console on your phone or to deploy.
# BOOTH_PASSCODE=
# PORT=3000
